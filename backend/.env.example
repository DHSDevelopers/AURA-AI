# ─────────────────────────────────────────────────────────────
# AURA AI — backend environment variables
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────

# Groq API keys — create them at https://console.groq.com/keys
# The server tries them in order and rotates automatically on 429/401/403.
# Leave unused slots empty (they are skipped), e.g. only set GROQ_KEY_1.
GROQ_KEY_1=your_groq_key_here
GROQ_KEY_2=
GROQ_KEY_3=
GROQ_KEY_4=
# Optional single-key fallback used when no GROQ_KEY_n is set
GROQ_API_KEY=

# Models — must be active on your Groq account
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Browser origins allowed to call this API (comma separated).
# Add your GitHub Pages URL and/or custom domain for production, e.g.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000
